# ==========================================
# EmailPro Configuration Template (.env.example)
# Copy these values into backend/appsettings.json or environment variables
# ==========================================

# Database Configuration (MongoDB)
MONGODB_CONNECTION_STRING=mongodb://127.0.0.1:27017
MONGODB_DATABASE_NAME=EmailProDb

# Authentication (JWT)
JWT_SECRET=EmailPro_SuperSecure_SecretKey_9876543210_JWT_Token_Key_2026
JWT_ISSUER=EmailProBackend
JWT_AUDIENCE=EmailProFrontend
JWT_EXPIRY_MINUTES=1440

# SMTP Sending Configuration (e.g. Gmail, Outlook, SendGrid, Mailgun, Amazon SES)
# For Gmail: Use smtp.gmail.com, Port 587, and generate an 16-character App Password at:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_SENDER_EMAIL=your_email@gmail.com
SMTP_SENDER_PASSWORD=your_16_char_app_password
SMTP_SENDER_NAME="Your Name"

# IMAP Receiving Configuration (For fetching inbound emails directly from your mailbox)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_ENABLE_SSL=true
IMAP_AUTO_SYNC=true
IMAP_SYNC_INTERVAL_MINUTES=5

# Inbound Webhook Configuration (For SendGrid Inbound Parse, Mailgun, or Postmark)
INBOUND_WEBHOOK_SECRET=emailpro_inbound_secret_token_12345
